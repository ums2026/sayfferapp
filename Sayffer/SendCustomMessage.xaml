<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Sayffer.SendCustomMessage">
    <ContentPage.Content>
        <StackLayout Margin="20" VerticalOptions="CenterAndExpand" Spacing="20" Orientation="Vertical">
            <Entry x:Name="MessageText" Placeholder="Quick, one-line message here" MaxLength="100"></Entry>
            <Label>Character Limit: 100</Label>
            <Picker x:Name="ClassCodeSend" Title="Send to:"></Picker>
            <Picker x:Name="SendTo" Title="Send to:"></Picker>
            <Label>Use this to send quick reminders in the form of push notifications</Label>
            <Button x:Name="Send" Text="Send" Clicked="Send_Clicked"></Button>

            <Button x:Name="BackToDashboard" Text="Back to Dashboard" TextColor="White" BackgroundColor="Black" Clicked="BackToDashboard_Clicked"></Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
